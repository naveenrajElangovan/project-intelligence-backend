PI_ENVIRONMENT=production
PI_LOG_LEVEL=INFO
PI_LOG_AUTHORIZATION_DETAILS=false
PI_RAG_SERVICE_URL=https://your-private-rag-service.example
PI_RAG_INTERNAL_API_KEY=load-from-azure-key-vault
PI_RAG_REQUEST_TIMEOUT_SECONDS=120
PI_RAG_MAX_CONNECTIONS=100
PI_RAG_MAX_KEEPALIVE_CONNECTIONS=20
PI_RAG_KEEPALIVE_EXPIRY_SECONDS=30
PI_TELEMETRY_HMAC_KEY=load-from-azure-key-vault
PI_INGESTION_INTERNAL_API_KEY=load-from-azure-key-vault
PI_CORS_ORIGINS=https://mobile.example.com
PI_ALLOWED_HOSTS=api.example.com
PI_FORCE_HTTPS=true
PI_DOCS_ENABLED=false
PI_MAX_REQUEST_BODY_BYTES=1048576
PI_DATABASE_URL=mssql+aioodbc://@projectintel-us3-1997.database.windows.net/project_intelligence?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
PI_DATABASE_MANAGED_IDENTITY_CLIENT_ID=33333333-3333-4333-8333-333333333333
# Must remain empty. Production uses the managed identity above.
PI_DATABASE_ACCESS_TOKEN=
PI_DATABASE_ECHO=false
PI_SECRET_STORE_BACKEND=azure-key-vault
PI_KEY_VAULT_URL=https://<vault-name>.vault.azure.net
# Development-only settings remain empty in production so both templates use the same keys.
PI_LOCAL_SECRET_STORE_PATH=.local-secrets.json
PI_PROVIDER_TOKEN_ENCRYPTION_KEY=

PI_ENTRA_TENANT_ID=
PI_ENTRA_AUDIENCE=
PI_ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
PI_ENTRA_REQUIRED_SCOPE=ProjectIntelligence.Access
PI_ENTRA_CLIENT_ID=
PI_ENTRA_CLIENT_SECRET=
PI_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
PI_GRAPH_SCOPE=https://graph.microsoft.com/.default
PI_ENTRA_CUSTOM_ATTRIBUTE_SET=ProjectIntelligence

PI_ATLASSIAN_CLIENT_ID=
PI_ATLASSIAN_CLIENT_SECRET=
PI_ATLASSIAN_REDIRECT_URI=https://api.example.com/v1/integrations/atlassian/callback
PI_ATLASSIAN_REQUIRE_EMAIL_MATCH=true
PI_ATLASSIAN_SCOPES=read:jira-work read:jira-user read:page:confluence read:attachment:confluence offline_access

# Restrict this to the address/range of the trusted TLS reverse proxy.
FORWARDED_ALLOW_IPS=127.0.0.1
