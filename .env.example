PI_ENVIRONMENT=development
PI_LOG_LEVEL=INFO
PI_RAG_SERVICE_URL=http://localhost:8002
PI_RAG_INTERNAL_API_KEY=replace-with-the-same-32-character-development-secret
# Optional local optimization. Leave disabled for a self-contained stack.
PI_RAG_USE_HOST_ACCELERATOR=false
PI_RAG_LOCAL_ACCELERATOR_RUNTIME_URL=
PI_RAG_LOCAL_ACCELERATOR_EMBEDDING_ENABLED=false
PI_RAG_REQUEST_TIMEOUT_SECONDS=120
PI_RAG_MAX_CONNECTIONS=100
PI_RAG_MAX_KEEPALIVE_CONNECTIONS=20
PI_RAG_KEEPALIVE_EXPIRY_SECONDS=30
PI_CHAT_MONGODB_ROOT_USERNAME=project-intelligence
PI_CHAT_MONGODB_ROOT_PASSWORD=replace-with-a-long-random-local-password
PI_CHAT_MONGODB_URL=mongodb://project-intelligence:replace-with-url-encoded-password@127.0.0.1:27018/?authSource=admin
PI_CHAT_MONGODB_DOCKER_URL=mongodb://project-intelligence:replace-with-url-encoded-password@mongodb:27017/?authSource=admin
PI_CHAT_MONGODB_DATABASE=project_intelligence_chat
PI_CHAT_RETENTION_DAYS=30
PI_CHAT_HISTORY_TURNS=3
PI_TELEMETRY_HMAC_KEY=replace-with-at-least-32-random-characters
PI_INGESTION_INTERNAL_API_KEY=
PI_ATLASSIAN_SERVICE_URL=http://atlassian:8000
PI_ATLASSIAN_SERVICE_INTERNAL_API_KEY=
# Evaluation submission is off the answer path and uses managed identity.
PI_EVALUATION_SERVICE_BUS_NAMESPACE=
PI_EVALUATION_SERVICE_BUS_QUEUE=ai-evaluations
PI_EVALUATION_MANAGED_IDENTITY_CLIENT_ID=
PI_EVALUATION_INTERNAL_API_KEY=
PI_LOG_AUTHORIZATION_DETAILS=false
PI_CORS_ORIGINS=http://localhost:8080
PI_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal,testserver
PI_FORCE_HTTPS=false
PI_DOCS_ENABLED=true
PI_MAX_REQUEST_BODY_BYTES=1048576
PI_DATABASE_URL=mssql+aioodbc://@projectintel-us3-1997.database.windows.net/project_intelligence?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
# Local Compose override. Mount-backed SQLite is the default local control plane.
PI_DATABASE_DOCKER_URL=sqlite+aiosqlite:////var/lib/project-intelligence/database/control-plane.db
PI_DATABASE_MANAGED_IDENTITY_CLIENT_ID=
# Development Docker only. Do not save an access token here; use scripts/start_dev_api.sh.
PI_DATABASE_ACCESS_TOKEN=
PI_DATABASE_ECHO=false
PI_DEV_SQL_AZURE_CONFIG_DIR=
# Used only by scripts/prepare_and_start_local_app.sh to keep one local firewall rule current.
PI_DEV_SQL_RESOURCE_GROUP=tiendas3b
PI_DEV_SQL_SERVER=projectintel-us3-1997
PI_DEV_SQL_FIREWALL_RULE_NAME=LocalDeveloperCurrentIP
PI_DEV_SQL_FIREWALL_SYNC=true
PI_DEV_API_REBUILD=false
PI_SECRET_STORE_BACKEND=local-encrypted
PI_KEY_VAULT_URL=
PI_ENTRA_TENANT_ID=11111111-1111-4111-8111-111111111111
PI_ENTRA_AUDIENCE=22222222-2222-4222-8222-222222222222
PI_ENTRA_ISSUER=https://login.microsoftonline.com/11111111-1111-4111-8111-111111111111/v2.0
PI_ENTRA_REQUIRED_SCOPE=ProjectIntelligence.Access
PI_ENTRA_CLIENT_ID=22222222-2222-4222-8222-222222222222
PI_ENTRA_CLIENT_SECRET=
PI_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
PI_GRAPH_SCOPE=https://graph.microsoft.com/.default
PI_ENTRA_CUSTOM_ATTRIBUTE_SET=ProjectIntelligence
PI_ATLASSIAN_CLIENT_ID=
PI_ATLASSIAN_CLIENT_SECRET=
PI_ATLASSIAN_REDIRECT_URI=http://localhost:8001/v1/integrations/atlassian/callback
PI_ATLASSIAN_REQUIRE_EMAIL_MATCH=false
PI_ATLASSIAN_SCOPES=read:jira-work read:jira-user read:page:confluence read:attachment:confluence offline_access
# Generate locally; never commit or reuse between environments.
PI_PROVIDER_TOKEN_ENCRYPTION_KEY=
PI_LOCAL_SECRET_STORE_PATH=.local-secrets.json
# Restrict this to the address/range of the trusted TLS reverse proxy.
FORWARDED_ALLOW_IPS=127.0.0.1
